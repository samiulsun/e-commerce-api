# E2E test environment (committed — contains no real secrets).
# Uses the isolated ecom_test database created by docker/initdb on first boot.
DATABASE_URL="postgresql://ecom:ecom@localhost:5432/ecom_test?schema=public"

JWT_ACCESS_SECRET="test-access-secret-0000000000000000000000"
JWT_REFRESH_SECRET="test-refresh-secret-11111111111111111111"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# No real Stripe calls in e2e: StripeService is overridden with a mock.
# The webhook secret is used to sign synthetic webhook events.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET="whsec_test_secret"

PORT=3001
