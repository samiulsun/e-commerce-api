# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://ecom:ecom@localhost:5432/ecom?schema=public"

# JWT — use long random strings in any non-local environment
JWT_ACCESS_SECRET="replace-me-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Stripe (test mode)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# App
PORT=3000
